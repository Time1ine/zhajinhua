<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>炸金花 · 联机版</title>
<style>
  :root{ --felt:#1a7a3a; --felt-dark:#0f4d24; --gold:#f5c542; }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:"PingFang SC","Microsoft YaHei",sans-serif;background:radial-gradient(circle at 50% 30%,#2b2b2b,#141414 80%);color:#eee;min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:16px;user-select:none;}
  h1{color:var(--gold);margin-bottom:12px;letter-spacing:4px;}
  .box{background:rgba(0,0,0,.5);border:2px solid var(--gold);border-radius:18px;padding:26px 32px;text-align:center;margin-top:6vh;}
  .box input{display:block;width:220px;margin:12px auto;padding:10px 14px;border-radius:8px;border:none;font-size:15px;text-align:center;}
  .box .divider{color:#888;margin:10px 0;}
  .box button{min-width:180px;}
  #waiting p{color:#bbb;margin:8px 0;font-size:14px;}
  #room-code{color:var(--gold);font-size:32px;letter-spacing:6px;font-weight:bold;display:block;margin:6px 0;}
  #waiting-players{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:14px 0;}
  .wp{background:rgba(255,255,255,.1);padding:8px 16px;border-radius:10px;font-size:14px;}

  #table{width:100%;max-width:980px;background:radial-gradient(ellipse at center,var(--felt),var(--felt-dark));border:12px solid #5b3a1a;border-radius:120px 120px 40px 40px;box-shadow:0 20px 60px rgba(0,0,0,.6),inset 0 0 80px rgba(0,0,0,.4);padding:18px 16px 14px;position:relative;display:none;}
  #players-row{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;}
  .player{flex:1 1 150px;min-width:120px;max-width:200px;text-align:center;background:rgba(0,0,0,.28);border-radius:16px;padding:10px 6px;}
  .player.active{outline:3px solid var(--gold);animation:pulse 1.1s infinite;}
  .player.me{background:rgba(245,197,66,.15);}
  @keyframes pulse{0%,100%{box-shadow:0 0 0 rgba(245,197,66,0);}50%{box-shadow:0 0 20px rgba(245,197,66,.85);}}
  .pname{font-weight:bold;font-size:14px;}
  .dealer-badge{display:inline-block;background:var(--gold);color:#4a2c00;border-radius:50%;width:18px;height:18px;line-height:18px;font-size:11px;font-weight:bold;margin-left:4px;}
  .turn-tag{font-size:12px;color:var(--gold);height:16px;margin-top:2px;font-weight:bold;}
  .chips{color:#ffe9a8;font-size:13px;margin:2px 0 4px;}
  .cards{display:flex;justify-content:center;gap:5px;min-height:80px;align-items:center;}
  .handtype{font-size:12px;color:#b7ffd0;margin-top:5px;min-height:16px;}
  .last-action{display:inline-block;background:#2e9e5b;color:#fff;border-radius:6px;padding:2px 9px;font-size:12px;margin-top:4px;}
  .last-action.fold{background:#c62828;} .last-action.raise{background:#f0a500;color:#4a2c00;}
  .last-action.look{background:#1976d2;} .last-action.out{background:#555;} .last-action.win{background:#7b1fa2;}

  .card{width:56px;height:80px;background:#fff;border-radius:7px;position:relative;box-shadow:0 3px 8px rgba(0,0,0,.45);display:flex;flex-direction:column;justify-content:center;align-items:center;}
  .card .big-suit{font-size:28px;line-height:1;}
  .card .corner{position:absolute;font-size:11px;line-height:1.1;text-align:center;font-weight:bold;}
  .card .corner.tl{top:4px;left:5px;} .card .corner.br{bottom:4px;right:5px;transform:rotate(180deg);}
  .card.red{color:#d32f2f;} .card.black{color:#222;}
  .card.back{background:repeating-linear-gradient(45deg,#7b1fa2,#7b1fa2 4px,#9c27b0 4px,#9c27b0 8px);border:2px solid #e0c3ff;}
  .card.back::after{content:"";position:absolute;inset:5px;border:2px solid rgba(255,255,255,.6);border-radius:4px;}

  #center{text-align:center;margin:14px 0 8px;}
  #pot{font-size:22px;color:#fff;text-shadow:0 2px 6px #000;} #pot b{color:var(--gold);}
  #announce{display:inline-block;font-size:18px;font-weight:bold;color:#fff;background:rgba(0,0,0,.55);border-radius:10px;padding:5px 18px;margin-top:6px;min-height:32px;}
  #log{background:rgba(0,0,0,.45);border-radius:10px;padding:8px 12px;height:88px;overflow-y:auto;font-size:12px;text-align:left;margin:8px 0;line-height:1.6;}
  #controls{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:10px;align-items:center;}
  #compare-layer{display:flex;justify-content:center;gap:8px;margin-top:8px;flex-wrap:wrap;align-items:center;}

  button{border:none;border-radius:10px;padding:11px 16px;font-size:15px;font-weight:bold;cursor:pointer;background:linear-gradient(#fff,#ddd);color:#333;box-shadow:0 4px 10px rgba(0,0,0,.4);}
  button:hover:not(:disabled){transform:translateY(-2px);} button:disabled{opacity:.35;cursor:not-allowed;}
  button.primary{background:linear-gradient(#ffd54f,#f0a500);color:#4a2c00;}
  button.danger{background:linear-gradient(#ef5350,#c62828);color:#fff;}
  button.info{background:linear-gradient(#64b5f6,#1976d2);color:#fff;}
  #over-box{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,.9);padding:26px 40px;border-radius:18px;border:2px solid var(--gold);text-align:center;display:none;z-index:5;}
  #over-box h2{color:var(--gold);margin-bottom:12px;}
</style>
</head>
<body>
  <h1>🃏 炸金花 · 联机版</h1>

  <div class="box" id="lobby">
    <input id="name-input" placeholder="输入你的昵称" maxlength="8">
    <button class="primary" onclick="createRoom()">🎉 创建房间</button>
    <div class="divider">—— 或 ——</div>
    <input id="room-input" placeholder="输入房间号" maxlength="5">
    <button class="info" onclick="joinRoom()">🔑 加入房间</button>
  </div>

  <div class="box" id="waiting" style="display:none">
    <h2>房间号</h2>
    <span id="room-code"></span>
    <p>把房间号发给朋友，让 TA 输入加入</p >
    <div id="waiting-players"></div>
    <button class="primary" id="start-btn" style="display:none" onclick="startGame()">开始游戏</button>
  </div>

  <div id="table">
    <div id="players-row"></div>
    <div id="center">
      <div id="pot">底池：<b>0</b></div>
      <div id="announce"></div>
    </div>
    <div id="log"></div>
    <div id="controls"></div>
    <div id="compare-layer"></div>
    <div id="over-box">
      <h2 id="over-title"></h2>
      <button class="primary" id="over-btn" onclick="onOverBtn()">再来一局</button>
    </div>
  </div>

<script src="/socket.io/socket.io.js"></script>
<script>
const socket=io();
const SUITS=['♠','♥','♦','♣'];
const RED=[false,true,true,false];
const RN={11:'J',12:'Q',13:'K',14:'A'};
let view=null, myId=null, choosingRaise=false, pendingCompare=false;

function rankName(r){return r<=10?String(r):RN[r];}
function myPlayer(){return view?view.players.find(p=>p.id===myId):null;}
function myIndex(){return view?view.players.findIndex(p=>p.id===myId):-1;}

function createRoom(){
  const name=document.getElementById('name-input').value.trim()||'玩家';
  socket.emit('create-room',{name});
}
function joinRoom(){
  const name=document.getElementById('name-input').value.trim()||'玩家';
  const id=document.getElementById('room-input').value.trim();
  socket.emit('join-room',{roomId:id,name});
}
socket.on('error',m=>alert(m));

socket.on('state',v=>{
  view=v; myId=v.you;
  document.getElementById('lobby').style.display='none';
  if(v.phase==='waiting'){
    document.getElementById('waiting').style.display='block';
    document.getElementById('table').style.display='none';
    document.getElementById('room-code').textContent=v.roomId;
    document.getElementById('waiting-players').innerHTML=
      v.players.map(p=>'<span class="wp">'+(p.id===v.hostId?'👑':'')+p.name+'</span>').join('');
    document.getElementById('start-btn').style.display=(v.you===v.hostId&&v.players.length>=2)?'inline-block':'none';
  }else{
    document.getElementById('waiting').style.display='none';
    document.getElementById('table').style.display='block';
    renderGame();
  }
});

function renderGame(){
  const g=view;
  document.getElementById('pot').innerHTML='底池：<b>'+g.pot+'</b>（当前注 '+g.currentBet+'）';
  const row=document.getElementById('players-row');
  row.innerHTML='';
  g.players.forEach((p,idx)=>{
    const isDealer=idx===g.dealer;
    const active=g.phase==='betting'&&idx===g.currentPlayer;
    const isMe=p.id===myId;
    const cards=p.cards.map(c=>cardHTML(c)).join('');
    const typeStr=p.evalName?'<div class="handtype">'+p.evalName+(p.evalIs235?'（胜豹子）':'')+'</div>':'<div class="handtype"></div>';
    const turnTxt=active?(isMe?'▶ 轮到你':'▶ 思考中…'):(g.phase==='betting'?'&nbsp;':'');
    const la=p.lastAction&&p.lastAction.text?'<div class="last-action '+p.lastAction.cls+'">'+p.lastAction.text+'</div>':'';
    row.innerHTML+=`<div class="player ${active?'active':''} ${isMe?'me':''}">
      <div class="pname">${isMe?'⭐':''}${p.name}${isDealer?'<span class="dealer-badge">庄</span>':''}</div>
      <div class="turn-tag">${turnTxt}</div>
      <div class="chips">筹码 ${p.chips}</div>
      <div class="cards">${cards}</div>
      ${typeStr}${la}
    </div>`;
  });
  renderControls();
}

function cardHTML(card){
  if(!card)return '<div class="card back"></div>';
  const red=RED[card.suit],r=rankName(card.rank),s=SUITS[card.suit];
  return `<div class="card ${red?'red':'black'}">
    <div class="corner tl"><span>${r}</span><br><span>${s}</span></div>
    <div class="big-suit">${s}</div>
    <div class="corner br"><span>${r}</span><br><span>${s}</span></div>
  </div>`;
}

function renderControls(){
  const ctrl=document.getElementById('controls');
  const cl=document.getElementById('compare-layer');
  cl.innerHTML='';
  const g=view, me=myPlayer(), idx=myIndex();
  const overBox=document.getElementById('over-box');

  if(g.phase==='over'){
    overBox.style.display='block';
    document.getElementById('over-title').textContent='🏆 '+g.winner+' 获胜！';
    document.getElementById('over-btn').style.display=g.you===g.hostId?'inline-block':'none';
    ctrl.innerHTML=''; return;
  }
  overBox.style.display='none';

  if(g.phase==='end'){
    ctrl.innerHTML=g.you===g.hostId
      ?'<button class="primary" onclick="socket.emit(\'next-hand\')">下一局</button>'
      :'<button disabled>等待房主开始下一局…</button>';
    return;
  }

  const myTurn=g.phase==='betting'&&idx===g.currentPlayer&&!me.folded&&!me.allIn;
  if(!myTurn){ctrl.innerHTML='<button disabled>等待其他玩家操作…</button>';return;}

  const need=g.currentBet-me.roundBet;

  if(choosingRaise){
    let html='<span style="font-weight:bold">加注：</span>';
    [10,20,50,100].forEach(a=>{
      html+='<button class="primary" '+(me.chips>=need+a?'':'disabled')+' onclick="raise('+a+')">+'+a+'</button>';
    });
    html+='<button class="primary" '+(me.chips>0?'':'disabled')+' onclick="raise(\'allin\')">全下</button>';
    html+='<button class="danger" onclick="choosingRaise=false;renderGame()">取消</button>';
    ctrl.innerHTML=html;
    return;
  }

  const canCompare=g.currentBet>10&&need<=0&&me.chips>=g.currentBet;
  ctrl.innerHTML=
    '<button class="info" '+(me.looked?'disabled':'')+' onclick="socket.emit(\'action\',{type:\'look\'})">看牌</button>'+
    '<button class="primary" onclick="socket.emit(\'action\',{type:\'call\'})">'+(need>0?'跟注 '+need:'过牌')+'</button>'+
    '<button class="primary" '+(me.chips>need?'':'disabled')+' onclick="choosingRaise=true;renderGame()">加注▾</button>'+
    '<button class="danger" onclick="socket.emit(\'action\',{type:\'fold\'})">弃牌</button>'+
    '<button class="info" '+(canCompare?'':'disabled')+' onclick="compareClick()">比牌(费用 '+g.currentBet+')</button>';

  if(pendingCompare){
    const opps=g.players.filter(p=>p.id!==myId&&!p.folded&&p.chips>0);
    cl.innerHTML='<span>选择比牌对象：</span>'+
      opps.map(p=>'<button class="info" onclick="socket.emit(\'action\',{type:\'compare\',targetId:\''+p.id+'\'})">'+p.name+'</button>').join('')+
      '<button class="danger" onclick="pendingCompare=false;renderGame()">取消</button>';
  }
}
function raise(a){ socket.emit('action',{type:'raise',amount:a}); }
function compareClick(){
  const g=view, me=myPlayer();
  const opps=g.players.filter(p=>p.id!==myId&&!p.folded&&p.chips>0);
  if(opps.length===1)socket.emit('action',{type:'compare',targetId:opps[0].id});
  else{pendingCompare=true;renderGame();}
}
function startGame(){ socket.emit('start-game'); }
function onOverBtn(){ socket.emit('restart'); }
</script>
</body>
</html>
